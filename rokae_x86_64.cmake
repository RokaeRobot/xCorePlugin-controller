# Rokae / x86_64 native: use with -DCMAKE_TOOLCHAIN_FILE=.../rokae_x86_64.cmake

set(CMAKE_SYSTEM_NAME Linux CACHE STRING "" FORCE)
set(CMAKE_SYSTEM_PROCESSOR x86_64 CACHE STRING "" FORCE)
set(ROKAE_ARCH "x86_64" CACHE STRING "Rokae SDK architecture" FORCE)

set(CMAKE_C_COMPILER "/usr/bin/gcc" CACHE STRING "" FORCE)
set(CMAKE_CXX_COMPILER "/usr/bin/g++" CACHE STRING "" FORCE)

set(CMAKE_C_FLAGS "-O2 -m64" CACHE STRING "" FORCE)
set(CMAKE_CXX_FLAGS "${CMAKE_C_FLAGS}" CACHE STRING "" FORCE)

set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER CACHE STRING "" FORCE)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY NEVER CACHE STRING "" FORCE)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE NEVER CACHE STRING "" FORCE)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE NEVER CACHE STRING "" FORCE)
