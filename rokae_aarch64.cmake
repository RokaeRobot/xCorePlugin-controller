# Rokae / aarch64 cross (Linaro): use with -DCMAKE_TOOLCHAIN_FILE=.../rokae_aarch64.cmake

set(CMAKE_SYSTEM_NAME Linux CACHE STRING "" FORCE)
set(CMAKE_SYSTEM_PROCESSOR aarch64 CACHE STRING "" FORCE)
set(ROKAE_ARCH "aarch64" CACHE STRING "Rokae SDK architecture" FORCE)

set(TOOLCHAIN_PATH "/opt/gcc-tool/gcc-linaro-6.3.1-2017.05-x86_64_aarch64-linux-gnu")
set(CMAKE_C_COMPILER "${TOOLCHAIN_PATH}/bin/aarch64-linux-gnu-gcc" CACHE STRING "" FORCE)
set(CMAKE_CXX_COMPILER "${TOOLCHAIN_PATH}/bin/aarch64-linux-gnu-g++" CACHE STRING "" FORCE)
set(CMAKE_SYSROOT "${TOOLCHAIN_PATH}/aarch64-linux-gnu/libc")


set(CMAKE_C_FLAGS "-O2 -march=armv8-a" CACHE STRING "" FORCE)
set(CMAKE_CXX_FLAGS "${CMAKE_C_FLAGS}" CACHE STRING "" FORCE)

set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER CACHE STRING "" FORCE)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY CACHE STRING "" FORCE)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY CACHE STRING "" FORCE)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY CACHE STRING "" FORCE)
